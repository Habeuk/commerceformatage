use Drupal\Core\Form\FormStateInterface;

/**
 * Alteration du processus du cehckout.
 *
 * @param array $form
 * @param FormStateInterface $form_state
 * @param string $form_id
 */
function commerceformatage_form_alter(array &$form, FormStateInterface $form_state, $form_id) {
  // dump($form_id);
  if (str_contains($form_id, 'commerce_checkout_flow')) {
    $form['#attributes']['class'][] = 'with-tablet mx-auto my-5';
    /**
     * Durant l'etape 'step_id:order_information', on met le paiement à la fin
     * car les informations d'expeditions qui sont en general rempli.
     * Celui de paiement n'etant donc qu'on copie.
     */
    if (!empty($form['#step_id']) && $form['#step_id'] == 'order_information') {
      // meme s'il nya qu'un seule methode de paiement on l'affiche à
      // l'utilisateur.
      if (!empty($form['payment_information']['payment_method']['#options']) && count($form['payment_information']['payment_method']['#options']) == 1)
        $form['payment_information']['payment_method']['#access'] = TRUE;
      // $form['payment_information']['#weight'] = 20;
    }
    /**
     * Bug rencontrer sur la desactivation d'une methode livraison en fonction
     * de la methode de livraison.
     * # Scenario
     * Si l'on desactive une mthode de livraison en fonction de la methode de
     * livraison, cela fonctionne uniquement dans le chargement de la page mais
     * pas via ajax.
     * Lorqu'on va selectionner une autre methode, le formulaire ajax en place
     * ne recharge pas le block Shipping.
     */
    if (!empty($form['payment_information']['payment_method']['#ajax']['callback'])) {
      // On va pre-sauvegarder la methode de paiement. En attendant la
      // resolution :
      // https://www.drupal.org/project/commerce_shipping/issues/3226851
      $form['payment_information']['payment_method']['#element_validate'][] = [
        \Drupal\commerceformatage\CommerceformatageAjax::class,
        'payment_method_callback_validate'
      ];
      // On definit un nouveau callback afin de mettre à jour les methodes de
      // shipping quand les methodes de payement est modifié.
      $form['payment_information']['payment_method']['#ajax']['callback'] = [
        \Drupal\commerceformatage\CommerceformatageAjax::class,
        'commerce_checkout_flow_callback'
      ];
    }
  }
}

/**
 * implement hook_element_info_alter()
